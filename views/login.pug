extends base.pug

block scripts
  script(src='/static/index.js')

block style
    style
      include ../static/style.css
      include ../static/styleContact.css

block content 
    div.container
        h1 Login to ADA
        
        //- NEW: This will display the error box ONLY if there is an error
        if error
            p(style="color: white; background-color: #ff4757; padding: 10px; border-radius: 5px; text-align: center; width: 40%; margin: 0 auto 15px auto;") #{error}
        
        form(action="/login", method="post", class="myform")
            input(type="email" , class="myInput", name="email", placeholder="Enter your Email", required)
            input(type="password" , class="myInput", name="password", placeholder="Enter your Password", required)
            button(class="btn") Login