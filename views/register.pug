extends base.pug

block scripts
  script(src='/static/index.js')

block style
    style
      include ../static/style.css
      include ../static/styleContact.css

block content 
    div.container
        h1 Create an Account
        
        //- NEW: Show error message if registration fails
        if error
            p(style="color: white; background-color: #ff4757; padding: 10px; border-radius: 5px; text-align: center; width: 40%; margin: 0 auto 15px auto;") #{error}

        form(action="/register", method="post", class="myform")
            input(type="text" , class="myInput", name="name", placeholder="Full Name", required)
            input(type="email" , class="myInput", name="email", placeholder="Email Address", required)
            input(type="password" , class="myInput", name="password", placeholder="Create Password", required)
            input(type="password" , class="myInput", name="confirm_password", placeholder="Confirm Password", required)
            button(class="btn") Register